#!/data/data/com.termux/files/usr/bin/bash
set -uo pipefail
CFG="$HOME/.config/tdm/config"; HIST="$HOME/.local/share/tdm/history.tsv"
mkdir -p "$(dirname "$CFG")" "$(dirname "$HIST")"
[ -f "$CFG" ] || printf 'LANG=vi\nDOWNLOAD_DIR=%s\nSPLIT=16\nRETRIES=5\n' "$HOME/storage/downloads/tdm" > "$CFG"
LANG_CODE=vi; DOWNLOAD_DIR="$HOME/storage/downloads/tdm"; SPLIT=16; RETRIES=5
while IFS='=' read -r k v; do case "$k" in LANG) LANG_CODE="$v";; DOWNLOAD_DIR) DOWNLOAD_DIR="$v";; SPLIT) SPLIT="$v";; RETRIES) RETRIES="$v";; esac; done < "$CFG"
# Upgrade the previous default connection count to the high-speed preset.
if [ "$SPLIT" = "8" ]; then SPLIT=16; fi
# Migrate the previous default while preserving user-selected directories.
if [ "$DOWNLOAD_DIR" = "$HOME/downloads" ]; then DOWNLOAD_DIR="$HOME/storage/downloads/tdm"; fi
# Ensure Android shared storage is linked; request permission when needed.
if [ ! -d "$HOME/storage/downloads" ]; then
  if command -v termux-setup-storage >/dev/null 2>&1; then
    echo "Requesting Android storage access..."
    termux-setup-storage
  fi
fi
if [ ! -d "$HOME/storage/downloads" ]; then
  echo "Cannot access Android Downloads. Grant storage permission, then restart TDM."
  exit 1
fi
# Always create the configured download directory if it is missing.
if ! mkdir -p "$DOWNLOAD_DIR"; then
  echo "Cannot create download directory: $DOWNLOAD_DIR"
  exit 1
fi
# Persist the migrated/default path for the next launch.
if ! grep -q "^DOWNLOAD_DIR=" "$CFG" || grep -q "^DOWNLOAD_DIR=$HOME/downloads$" "$CFG"; then
  sed -i "s|^DOWNLOAD_DIR=.*|DOWNLOAD_DIR=$DOWNLOAD_DIR|" "$CFG"
fi
t(){ case "$LANG_CODE:$1" in
vi:title) echo "TDM - QUẢN LÝ TẢI XUỐNG";; en:title) echo "TDM - DOWNLOAD MANAGER";;
vi:one) echo "Tải một URL";; en:one) echo "Download one URL";;
vi:batch) echo "Tải danh sách URL";; en:batch) echo "Download URL list";;
vi:video) echo "Tải đa nền tảng (TVDL)";; en:video) echo "Multi-platform downloader (TVDL)";;
vi:tasks) echo "Tiến trình tải";; en:tasks) echo "Download processes";;
vi:history) echo "Lịch sử";; en:history) echo "History";;
vi:files) echo "Quản lý tệp";; en:files) echo "File manager";;
vi:queue) echo "Hàng đợi";; en:queue) echo "Queue";;
vi:settings) echo "Cài đặt";; en:settings) echo "Settings";;
vi:language) echo "Ngôn ngữ";; en:language) echo "Language";;
vi:update) echo "Cập nhật";; en:update) echo "Update";;
vi:uninstall) echo "Gỡ cài đặt TDM";; en:uninstall) echo "Uninstall TDM";;
vi:exit) echo "Thoát";; en:exit) echo "Exit";;
vi:url) echo "Nhập URL:";; en:url) echo "Enter URL:";;
*) echo "$1";; esac; }
pause(){ read -r -p "Enter..."; }
get_url(){ read -r -p "$(t url) " URL; [[ "$URL" =~ ^(https?|ftp):// ]] || { echo "Invalid URL"; return 1; }; }
download(){ local url="$1" rc=0; mkdir -p "$DOWNLOAD_DIR"; if command -v aria2c >/dev/null; then
  aria2c --continue=true --max-connection-per-server="$SPLIT" --split="$SPLIT" --min-split-size=1M --max-tries="$RETRIES" --retry-wait=2 --connect-timeout=15 --timeout=60 --file-allocation=none --summary-interval=1 --dir="$DOWNLOAD_DIR" "$url" || rc=$?
 else
  echo "aria2c is not installed; curl fallback uses a single connection. Install with: pkg install aria2"
  (cd "$DOWNLOAD_DIR" && curl -fL -C - --retry "$RETRIES" --retry-delay 2 --connect-timeout 15 --max-time 0 -O "$url") || rc=$?
 fi; printf '%s\t%s\t%s\n' "$(date -Iseconds)" "$url" "$rc" >> "$HIST"; return "$rc"; }
while true; do
 clear 2>/dev/null || true
 printf '\033[1;36m'; cat <<'ART'
 _____  ____  __  __
|_   _||  _ \|  \/  |
  | |  | | | | |\/| |
  | |  | |_| | |  | |
  |_|  |____/|_|  |_|
ART
 printf '\033[0m%s\n' "$(t title)" "--------------------------------"
 printf '1) %s\n2) %s\n3) %s\n4) %s\n5) %s\n6) %s\n7) %s\n8) %s\n9) %s\n10) %s\n11) %s\n0) %s\n' "$(t one)" "$(t batch)" "$(t video)" "$(t tasks)" "$(t history)" "$(t files)" "$(t queue)" "$(t settings)" "$(t language)" "$(t update)" "$(t uninstall)" "$(t exit)"
 read -r -p "> " c
 case "$c" in
 1) if get_url; then download "$URL"; fi; pause;;
 2) read -r -p "TXT file: " f; if [ -f "$f" ]; then while IFS= read -r u; do [[ "$u" =~ ^(https?|ftp):// ]] && download "$u"; done < "$f"; else echo "File not found"; fi; pause;;
 3)
    helper="$HOME/.local/share/tdm/tvdl.sh"
    tmp_helper="$(mktemp)"
    mkdir -p "$(dirname "$helper")"
    if curl -fsSL --retry 2 "https://raw.githubusercontent.com/khahdihdz/tvdl/main/tvdl.sh" -o "$tmp_helper"; then
      if bash -n "$tmp_helper"; then
        install -m 700 "$tmp_helper" "$helper"
      else
        echo "TVDL source has a syntax error; keeping cached copy."
      fi
    elif [ -s "$helper" ]; then
      echo "Cannot reach GitHub; using cached TVDL."
    else
      echo "Cannot download TVDL. Check your Internet connection."
      rm -f "$tmp_helper"
      pause
      continue
    fi
    rm -f "$tmp_helper"
    if [ ! -s "$helper" ]; then echo "TVDL is unavailable."; pause; continue; fi
    tvdl_cfg="$HOME/.config/termux-video-downloader/config.conf"
    if [ ! -f "$tvdl_cfg" ]; then
      mkdir -p "$(dirname "$tvdl_cfg")"
      printf 'DOWNLOAD_DIR=%q\\nDEFAULT_FORMAT=mp4\\nDEFAULT_QUALITY=1\\nAUDIO_FORMAT=mp3\\nCOLOR=1\\n' "$DOWNLOAD_DIR" > "$tvdl_cfg"
    fi
    bash "$helper"
    pause;;

 4) pgrep -af 'aria2c|yt-dlp|curl|wget' || true; pause;;
 5) cat "$HIST" 2>/dev/null || echo "Empty"; pause;;
 6) ls -lah "$DOWNLOAD_DIR"; pause;;
 7) read -r -p "URL: " u; [[ "$u" =~ ^(https?|ftp):// ]] && echo "$u" >> "$HOME/.local/share/tdm/queue.txt"; echo "Queued. Use batch list to process queue."; pause;;
 8) echo "Current directory: $DOWNLOAD_DIR"; echo "aria2 mode: up to 16 connections per server; actual speed depends on server/network."; read -r -p "New directory (blank=keep): " d; [ -n "$d" ] && DOWNLOAD_DIR="$d"; read -r -p "Connections (1-16, recommended 16): " n; [[ "$n" =~ ^([1-9]|1[0-6])$ ]] && SPLIT="$n"; cat > "$CFG" <<EOF
LANG=$LANG_CODE
DOWNLOAD_DIR=$DOWNLOAD_DIR
SPLIT=$SPLIT
RETRIES=$RETRIES
EOF
 pause;;
 9) echo "1) Tiếng Việt  2) English"; read -r -p "> " l; case "$l" in 1) LANG_CODE=vi;; 2) LANG_CODE=en;; esac; sed -i "s/^LANG=.*/LANG=$LANG_CODE/" "$CFG";;
 10) updater="$HOME/.local/share/tdm/update.sh"; tmp_updater="$(mktemp)"; if curl -fsSL "https://raw.githubusercontent.com/khahdihdz/tdm/main/update.sh" -o "$tmp_updater"; then install -m 700 "$tmp_updater" "$updater"; rm -f "$tmp_updater"; bash "$updater"; else rm -f "$tmp_updater"; echo "Không tải được trình cập nhật. Kiểm tra Internet."; pause; fi;;
 11) bash "$HOME/.local/share/tdm/uninstall.sh"; exit 0;;
 0) exit 0;;
 *) echo "Invalid"; sleep 1;;
 esac
done
